# Tyll demo settings. Copy to .env.local and change what you need. Never commit real keys.

# Demo mode: demo account list on the sign-in page, demo PINs on the PIN screen, guided demo and demo reset.
# Set to "off" for anything other than a demonstration.
TYLL_DEMO_MODE=on

# Where the server keeps its records (defaults shown). Delete the folder to start again.
# TYLL_PURCHASING_STORE=.data/purchasing.json
# TYLL_AUTH_STORE=.data/auth.json

# Session limits in seconds.
# TYLL_SESSION_IDLE_SECONDS=3600
# TYLL_SESSION_MAX_SECONDS=43200
# TYLL_PIN_IDLE_SECONDS=600

# Links inside notification emails.
# TYLL_PUBLIC_URL=http://localhost:3210

# Optional email for important handoffs. Without these, emails are only shown as previews in Settings and nothing is sent.
# The demo accounts use @grandresorts.example addresses, which cannot receive mail; to test real delivery, set
# TYLL_DEMO_EMAIL_DOMAIN to a domain whose inbox you control (emails go to <user-id>@that-domain).
# TYLL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# TYLL_EMAIL_FROM=Tyll Demo <demo@your-verified-domain>
# TYLL_DEMO_EMAIL_DOMAIN=
