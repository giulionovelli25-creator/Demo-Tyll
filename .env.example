# Tyll demo settings. Copy to .env.local and change what you need. Never commit real keys.

# Demo mode: demo account list on the sign-in page, demo PINs on the PIN screen, guided demo and demo reset.
# Set to "off" for anything other than a demonstration.
TYLL_DEMO_MODE=on

# Where the server keeps its records (defaults shown). Delete the folder to start again.
# TYLL_PURCHASING_STORE=.data/purchasing.json
# TYLL_AUTH_STORE=.data/auth.json

# Session limits in seconds.
# TYLL_SESSION_IDLE_SECONDS=3600
# TYLL_SESSION_MAX_SECONDS=43200
# TYLL_PIN_IDLE_SECONDS=600

# Links inside notification emails.
# TYLL_PUBLIC_URL=http://localhost:3210

# Optional email for important handoffs. Without these, emails are only shown as previews in Settings and nothing is sent.
# The demo accounts use @grandresorts.example addresses, which cannot receive mail; to test real delivery, set
# TYLL_DEMO_EMAIL_DOMAIN to a domain whose inbox you control (emails go to <user-id>@that-domain).
# TYLL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# TYLL_EMAIL_FROM=Tyll Demo <demo@your-verified-domain>
# TYLL_DEMO_EMAIL_DOMAIN=

# Public demo (demo.tyll.ai): "on" replaces sign-in and PINs with a welcome screen and a four-role switcher,
# and deep links such as /forecast?tab=buy open directly. Off by default; accounts and PINs are unchanged.
TYLL_PUBLIC_DEMO=off

# Demo visits (/admin/visits): which pages visitors who agreed in the banner open, and for how long.
# Without GitHub sign-in or TYLL_ADMIN_KEY, the page opens only on the computer running Tyll (localhost).
# Never commit real values: put them in .env.local or the host's settings.
#
# Sign in with GitHub, for the team. Register an OAuth App at github.com > Settings > Developer settings > OAuth Apps,
# with the callback URL <site>/api/admin/github/callback (http://localhost:3210/api/admin/github/callback locally).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Who may sign in: GitHub usernames, comma separated ...
# TYLL_ADMIN_GITHUB_USERS=
# ... and/or everyone with access to this repository, checked with a fine-grained token that has read-only
# "Metadata" access to that one repository.
# TYLL_ADMIN_GITHUB_REPO=owner/repo
# TYLL_ADMIN_GITHUB_TOKEN=
# Set TYLL_PUBLIC_URL (above) when deployed behind a proxy, so GitHub sends people back to the public address.
#
# Or a shared key: anyone who types it may open the page.
# TYLL_ADMIN_KEY=
# Messages to the team when a visit starts, and a daily summary. Slack wins if both are set. Without either, messages
# are only listed on the visits page and nothing is sent.
# TYLL_SLACK_WEBHOOK_URL=
# TYLL_VISIT_ALERT_EMAIL=        (uses TYLL_EMAIL_PROVIDER, RESEND_API_KEY and TYLL_EMAIL_FROM above)
# The time zone that decides which day a visit counts towards. Default: the demo hotel's, Europe/Lisbon.
# TYLL_TEAM_TIME_ZONE=
